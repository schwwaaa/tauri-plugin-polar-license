# ─────────────────────────────────────────────────────────────────────────
#  Copy to config.env and fill in. Nothing here is secret.
#  The two tokens are asked for by ./deploy.sh and kept in secrets.env.
# ─────────────────────────────────────────────────────────────────────────

# Cloudflare account ID: the long code in the dashboard's address bar,
# dash.cloudflare.com/<THIS-PART>/...
CF_ACCOUNT_ID="PASTE-CLOUDFLARE-ACCOUNT-ID"

# Becomes part of the address: https://<WORKER_NAME>.<subdomain>.workers.dev
WORKER_NAME="polar-license"

# Production: https://api.polar.sh    Sandbox: https://sandbox-api.polar.sh
POLAR_API_BASE="https://api.polar.sh"

# Polar → Settings → General → Organization ID (same environment as above).
POLAR_ORGANIZATION_ID="PASTE-POLAR-ORGANIZATION-ID"

# License Keys benefit ID(s). Several apps? Separate with commas.
POLAR_BENEFIT_IDS="PASTE-BENEFIT-ID"
