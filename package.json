{
  "name": "tauri-plugin-polar-license-api",
  "version": "0.1.0",
  "description": "Front-end bindings for tauri-plugin-polar-license (Polar.sh license keys for Tauri v2).",
  "license": "MIT OR Apache-2.0",
  "author": "schwwaaa",
  "repository": { "type": "git", "url": "https://github.com/schwwaaa/tauri-plugin-polar-license" },
  "keywords": ["tauri", "tauri-plugin", "polar", "license", "licensing"],
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.js",
  "exports": {
    ".": { "types": "./dist-js/index.d.ts", "import": "./dist-js/index.js" },
    "./ui/polar-license.js": "./ui/polar-license.js",
    "./ui/polar-license.css": "./ui/polar-license.css"
  },
  "files": ["dist-js", "ui", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:ui": "node --check ui/polar-license.js"
  },
  "peerDependencies": { "@tauri-apps/api": "^2.0.0" },
  "devDependencies": { "@tauri-apps/api": "^2.0.0", "typescript": "^5.4.0" }
}
